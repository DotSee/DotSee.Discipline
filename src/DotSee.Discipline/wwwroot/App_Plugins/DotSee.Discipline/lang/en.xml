<?xml version="1.0" encoding="utf-8"?>
<!--
  Server-side language file for DotSee.Discipline.

  Discovered by Umbraco's management API (UmbracoBuilder.LocalizedText) which scans
  App_Plugins/<plugin>/lang/*.xml via the web-root (and content-root) file providers and
  registers them as LocalizedTextServiceSupplementaryFileSource. This backs the EventMessages /
  notifications raised from the feature event handlers via ILocalizedTextService.Localize(
  "dotseeDiscipline", "<key>", ...). Separate system from the backoffice UI localization in
  Client/src/localization/en.ts. Token placeholders use the %0%, %1% ... convention.

  Lives in Client/public/lang so Vite (emptyOutDir) re-copies it into
  wwwroot/App_Plugins/DotSee.Discipline/lang on every build.
-->
<language alias="en" intName="English" localName="English" lcid="" culture="en-US">
  <area alias="dotseeDiscipline">

    <!-- AiSummary (ContentSavingHandler) -->
    <key alias="aiSummaryCategory">AI Summarization</key>
    <key alias="aiSummaryGenerated">AI summary generated.</key>
    <key alias="aiSummaryError">The AI summary could not be generated. See the log for details.</key>

    <!-- NodeProtect (RuleMessageManager) -->
    <key alias="nodeProtectDefaultCategory">Node protected</key>
    <key alias="nodeProtectDefaultMessage">The node '%0%' (id %1%) is protected and cannot be deleted.</key>

    <!-- NodeRestrict (RuleMessageManager) -->
    <key alias="nodeRestrictDefaultCategory">Node limit reached</key>
    <key alias="nodeRestrictDefault">A maximum of %0% child node(s) %1% is allowed under %2%.</key>
    <key alias="nodeRestrictFromProperty">A maximum of %0% child node(s) is allowed under this node.</key>
    <key alias="nodeRestrictOfAnyType">of any type</key>
    <key alias="nodeRestrictOfType">of type '%0%'</key>
    <key alias="nodeRestrictAnyNode">any node</key>
    <key alias="nodeRestrictNodesOfType">nodes of type '%0%'</key>
    <key alias="nodeRestrictWarningDefault">%3% under %2% are limited to %0%. You are about to create node number %1%.</key>
    <key alias="nodeRestrictWarningFromProperty">You are about to create node number %0% of a maximum of %1% allowed under this node.</key>
    <key alias="nodeRestrictAnyNodeCap">Nodes of any type</key>
    <key alias="nodeRestrictNodesOfTypeCap">Nodes of type '%0%'</key>

    <!-- Backoffice settings API (DisciplineSettingsController) -->
    <key alias="apiSettingsRequired">Settings are required.</key>
    <key alias="apiNoAppsettingsFound">No DotSee.Discipline configuration was found in appsettings.json.</key>

  </area>
</language>
